<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>

    <!-- xUnit.net v3 test projects are stand-alone executables; the project is its own
         runner. global.json selects the Microsoft.Testing.Platform runner for dotnet test. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DataMapper.Extensions\DataMapper.Extensions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="TestData.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
