<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <!-- No blazor.web.js: there is no circuit. htmx is the only client script, and it is here to
         swap fragments. Every htmx element still has a plain href or form action, so the app works
         without it. -->
    <script src="@Assets["htmx.min.js"]" defer></script>

    <Routes />
</body>

</html>
